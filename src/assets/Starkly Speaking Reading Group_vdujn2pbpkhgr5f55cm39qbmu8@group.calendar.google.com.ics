UID:4om8dkr7eu2gvvk4o4mi4c9bjg_R20230327T150000@google.com
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=mh
