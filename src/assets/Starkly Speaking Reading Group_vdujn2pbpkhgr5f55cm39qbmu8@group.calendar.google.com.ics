UID:b1qril1ke5kft3h5gbg6tqm1ob@google.com
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=jk
 object@gmail.com;X-NUM-GUESTS=0:mailto:jkobject@gmail.com
