ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=DECLINED;CN=roseyu
 @eng.ucsd.edu;X-NUM-GUESTS=0:mailto:roseyu@eng.ucsd.edu
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=ro
 seyu@ucsd.edu;X-NUM-GUESTS=0:mailto:roseyu@ucsd.edu
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=rsfwal
 ters@gmail.com;X-NUM-GUESTS=0:mailto:rsfwalters@gmail.com
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=ru
 w020@ucsd.edu;X-NUM-GUESTS=0:mailto:ruw020@ucsd.edu
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=q6
 yu@ucsd.edu;X-NUM-GUESTS=0:mailto:q6yu@ucsd.edu
