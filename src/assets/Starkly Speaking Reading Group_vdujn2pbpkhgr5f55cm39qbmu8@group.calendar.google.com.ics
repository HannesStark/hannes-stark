 ujn2pbpkhgr5f55cm39qbmu8@group.calendar.google.com
UID:4om8dkr7eu2gvvk4o4mi4c9bjg_R20231030T160000@google.com
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=alex@n
 naisense.com;X-NUM-GUESTS=0:mailto:alex@nnaisense.com
