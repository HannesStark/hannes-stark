UID:b1qril1ke5kft3h5gbg6tqm1ob_R20250317T170000@google.com
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=ah
 ern@uw.edu;X-NUM-GUESTS=0:mailto:ahern@uw.edu
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=jasonk
 yuyim@gmail.com;X-NUM-GUESTS=0:mailto:jasonkyuyim@gmail.com
