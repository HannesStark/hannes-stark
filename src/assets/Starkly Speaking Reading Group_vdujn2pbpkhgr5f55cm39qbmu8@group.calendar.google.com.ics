ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=daras.
 giannhs@gmail.com;X-NUM-GUESTS=0:mailto:daras.giannhs@gmail.com
