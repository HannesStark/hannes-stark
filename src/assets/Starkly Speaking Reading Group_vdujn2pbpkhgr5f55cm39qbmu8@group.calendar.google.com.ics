ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=antho.
 marchand@gmail.com;X-NUM-GUESTS=0:mailto:antho.marchand@gmail.com
