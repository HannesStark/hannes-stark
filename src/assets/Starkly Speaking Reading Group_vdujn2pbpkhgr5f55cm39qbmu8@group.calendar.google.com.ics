ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=johann
 es.lutzeyer@gmail.com;X-NUM-GUESTS=0:mailto:johannes.lutzeyer@gmail.com
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=mixali
 sx97@gmail.com;X-NUM-GUESTS=0:mailto:mixalisx97@gmail.com
