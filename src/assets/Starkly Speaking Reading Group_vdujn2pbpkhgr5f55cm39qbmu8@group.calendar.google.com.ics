 am@tatta.bio;X-NUM-GUESTS=0:mailto:team@tatta.bio
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=yunha@
