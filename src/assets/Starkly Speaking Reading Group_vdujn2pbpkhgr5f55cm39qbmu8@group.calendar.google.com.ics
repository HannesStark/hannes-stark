ORGANIZER;CN=vdujn2pbpkhgr5f55cm39qbmu8@group.calendar.google.com:mailto:vd
 ujn2pbpkhgr5f55cm39qbmu8@group.calendar.google.com
UID:b1qril1ke5kft3h5gbg6tqm1ob@google.com
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=ad
 itik1@berkeley.edu;X-NUM-GUESTS=0:mailto:aditik1@berkeley.edu
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=ericqu
 @berkeley.edu;X-NUM-GUESTS=0:mailto:ericqu@berkeley.edu
