ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=gs
 2747@columbia.edu;X-NUM-GUESTS=0:mailto:gs2747@columbia.edu
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=js
 pence@stanford.edu;X-NUM-GUESTS=0:mailto:jspence@stanford.edu
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=ma
 gu@stanford.edu;X-NUM-GUESTS=0:mailto:magu@stanford.edu
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=pr
 itch@stanford.edu;X-NUM-GUESTS=0:mailto:pritch@stanford.edu
