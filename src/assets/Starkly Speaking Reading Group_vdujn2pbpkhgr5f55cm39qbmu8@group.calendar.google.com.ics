ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=fedelo
 pez77@gmail.com;X-NUM-GUESTS=0:mailto:fedelopez77@gmail.com
