UID:4om8dkr7eu2gvvk4o4mi4c9bjg_R20240812T150000@google.com
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=an
 dre@tatta.bio;X-NUM-GUESTS=0:mailto:andre@tatta.bio
