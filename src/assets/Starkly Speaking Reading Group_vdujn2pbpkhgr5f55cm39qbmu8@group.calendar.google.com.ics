ORGANIZER;CN=vdujn2pbpkhgr5f55cm39qbmu8@group.calendar.google.com:mailto:vd
 ujn2pbpkhgr5f55cm39qbmu8@group.calendar.google.com
UID:4om8dkr7eu2gvvk4o4mi4c9bjg_R20230327T150000@google.com
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;CN=martin
 sipka@gmail.com;X-NUM-GUESTS=0:mailto:martinsipka@gmail.com
ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;CN=si
 pkam@mit.edu;X-NUM-GUESTS=0:mailto:sipkam@mit.edu
